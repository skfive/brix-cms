# Server
PORT=3000

# Database (SQLite — docker-compose 에서는 /data/dev.db 로 override 됨)
DATABASE_URL="file:./dev.db"

# JWT 서명 시크릿 (필수 — 임의의 긴 문자열로 교체하세요)
# 생성 예시: openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-secret"

# CORS 허용 origin 화이트리스트 (comma-separated, BF-727)
# 미지정 시 dev 기본값(http://localhost:3000, http://localhost:3001) 사용.
# 프로덕션에서는 실제 프론트엔드 도메인으로 교체하세요.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
