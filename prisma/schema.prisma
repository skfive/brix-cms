// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Placeholder model — subsequent tasks will add domain models
model HealthLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}

// BF-683: 사용자 인증 모델 (BF-687: Post/Page/Comment relation 추가)
model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  role          String    @default("user")
  posts         Post[]    @relation("PostAuthor")
  pages         Page[]    @relation("PageAuthor")
  comments      Comment[] @relation("CommentAuthor")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// BF-687: 블로그 포스트 모델
// status: "DRAFT" | "PUBLISHED" | "ARCHIVED" (SQLite 특성상 String 저장, PublishStatus enum 으로 앱 레벨 검증)
model Post {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String?
  status    String   @default("DRAFT")
  authorId  Int
  author    User     @relation("PostAuthor", fields: [authorId], references: [id])
  comments  Comment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BF-687: 정적 페이지 모델
// status: "DRAFT" | "PUBLISHED" | "ARCHIVED" (SQLite 특성상 String 저장, PublishStatus enum 으로 앱 레벨 검증)
model Page {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String?
  status    String   @default("DRAFT")
  authorId  Int
  author    User     @relation("PageAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// BF-687: 댓글 모델
model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  authorId  Int
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
